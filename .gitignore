<!-- Keep the tree free of build output, local state and secrets. -->
/bin/
/dist/
*.exe
*.test
*.out

# Local tooling / editor state
.DS_Store
Thumbs.db
.idea/
.vscode/
*~

# Python bytecode from the harness's own scripts
__pycache__/
*.pyc

# Local scratch and evidence dumps that must not be committed
/tmp/
/scratch/
*.log

# Scratch trees a killed test or check run can leave behind in the repository root: the parity
# suite's throw-away trees, its comparison base, and scripts/portability.py's scratch (whose checker
# refuses a temp root inside this tree -- these patterns are the second line of defence, so a stray
# directory can never be something `git status` offers to commit). See docs/harness.md.
/parity-root-*/
/import-root-*/
/compare-checkout-*/
/portability-root-*/

# Secrets: never commit credentials, tokens or real session transcripts
.env
.env.*
*.pem
*.key
credentials.json
